{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --port 4173 --strictPort",
      "startServerReadyPattern": "Local",
      "url": [
        "http://localhost:4173/kobo-keys/en/login",
        "http://localhost:4173/kobo-keys/en",
        "http://localhost:4173/kobo-keys/en/catalog",
        "http://localhost:4173/kobo-keys/en/product/sakura-65"
      ],
      "puppeteerScript": "./scripts/lhci-sign-in.cjs",
      "puppeteerLaunchOptions": {
        "args": ["--no-sandbox"]
      },
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "disableStorageReset": true
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
