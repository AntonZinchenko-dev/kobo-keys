{
  "name": "kobo-keys",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "KŌBŌ Keys — e-commerce / SaaS portfolio project: mechanical keyboards shop with MSW-mocked backend, deployed to GitHub Pages",
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.2",
    "clsx": "^2.1.1",
    "i18next": "^25.10.10",
    "i18next-icu": "^2.5.0",
    "i18next-resources-to-backend": "^1.2.3",
    "idb-keyval": "^6.3.0",
    "intl-messageformat": "^12.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^15.7.4",
    "react-router": "^7.18.4",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@playwright/test": "^1.64.0",
    "@size-limit/file": "^14.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.4.0",
    "lucide-static": "^1.56.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "size-limit": "^14.2.0",
    "steiger": "^0.7.0",
    "stylelint": "^17.16.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.2",
    "tsx": "^4.23.15",
    "typescript": "~5.8",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:fsd": "steiger ./src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm run lint && npm run lint:css && npm run lint:fsd && npm run format:check && npm run test",
    "images": "tsx scripts/build-images.ts && tsx scripts/build-image-readmes.ts",
    "images:readme": "tsx scripts/build-image-readmes.ts",
    "sprite": "tsx scripts/build-sprite.ts",
    "size": "size-limit",
    "prepare": "husky || true",
    "icons": "tsx scripts/build-icons.ts"
  }
}
